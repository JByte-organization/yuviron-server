# Runtime data — never send to daemon
env/
backups/
certs/
generated/
logs/
storage/

# Infra tool — not part of any image
scripts/
docs/
config/
.github/
.tmp/

# Git and editor
.git
*.md

# Python
.venv/
venv/
__pycache__/
*.pyc

# .NET build artifacts
**/bin/
**/obj/

# Frontend source and build artifacts — frontend images use src/yuviron-frontend as context
src/yuviron-frontend/
**/node_modules/
**/.next/
**/.turbo/
**/out/