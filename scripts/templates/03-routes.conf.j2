{% for route in routes %}
    server {
        listen 80;
        server_name {{ route.host }};

        access_log /dev/stdout main;
        error_log  /dev/stderr warn;

        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "edge-nginx-ok\n";
        }

        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type text/plain;
            try_files $uri =404;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name {{ route.host }};

        access_log /dev/stdout main;
        error_log  /dev/stderr warn;

        ssl_certificate $route_ssl_certificate;
        ssl_certificate_key $route_ssl_certificate_key;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        {% for header in security_headers %}
        add_header {{ header.name }} "{{ header.value }}" always;
        {% endfor %}

        client_max_body_size {{ route.client_max_body_size }};

        location / {
            {% if route.basic_auth %}
            {% for cidr in route.admin_allowlist %}
            allow {{ cidr }};
            {% endfor %}
            deny all;

            auth_basic "Yuviron internal";
            auth_basic_user_file /etc/nginx/htpasswd;
            {% endif %}

            {% if route.rate_limit_zone %}
            limit_req zone={{ route.rate_limit_zone }} burst={{ route.rate_limit_burst }} nodelay;
            limit_req_status 429;
            {% endif %}

            proxy_pass http://{{ route.upstream }};
            include /etc/nginx/proxy-params.conf;

            proxy_connect_timeout 5s;
            proxy_send_timeout 15s;
            proxy_read_timeout 3600s;
        }

        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "edge-nginx-ok\n";
        }

        location ~ /\.(?!well-known) {
            deny all;
            access_log off;
            log_not_found off;
        }

        {% if route.has_auth_endpoints %}
        location ~* ^/(auth|account|login|register|token|refresh) {
            {% if route.basic_auth %}
            {% for cidr in route.admin_allowlist %}
            allow {{ cidr }};
            {% endfor %}
            deny all;

            auth_basic "Yuviron internal";
            auth_basic_user_file /etc/nginx/htpasswd;
            {% endif %}

            limit_req zone=api_auth burst=3 nodelay;
            limit_req_status 429;

            proxy_pass http://{{ route.upstream }};
            include /etc/nginx/proxy-params.conf;
        }
        {% endif %}

        {% if route.upload_locations %}
        location ~* ^/({{ route.upload_locations_pattern }}) {
            client_max_body_size {{ route.upload_client_max_body_size }};

            {% if route.upload_rate_limit_zone %}
            limit_req zone={{ route.upload_rate_limit_zone }} burst={{ route.upload_rate_limit_burst }} nodelay;
            limit_req_status 429;
            {% endif %}

            proxy_request_buffering off;

            proxy_pass http://{{ route.upstream }};
            include /etc/nginx/proxy-params.conf;
        }
        {% endif %}
    }

{% endfor %}
}
