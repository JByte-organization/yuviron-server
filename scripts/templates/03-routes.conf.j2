{% for route in routes %}
    server {
        listen 80;
        server_name {{ route.host }};

        access_log /var/log/nginx/{{ route.log_name }}.access.log main;
        error_log  /var/log/nginx/{{ route.log_name }}.error.log warn;

        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "edge-nginx-ok\n";
        }

        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name {{ route.host }};

        access_log /var/log/nginx/{{ route.log_name }}.access.log main;
        error_log  /var/log/nginx/{{ route.log_name }}.error.log warn;

        ssl_certificate /etc/nginx/certs/cert.pem;
        ssl_certificate_key /etc/nginx/certs/key.pem;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        client_max_body_size {{ route.client_max_body_size }};

        location / {
            {% if route.name == "api" %}
            limit_req zone=api_general burst=20 nodelay;
            limit_req_status 429;
            {% endif %}

            proxy_pass http://{{ route.upstream }};
            include /etc/nginx/proxy-params.conf;

            proxy_connect_timeout 5s;
            proxy_send_timeout 15s;
            proxy_read_timeout 3600s;
        }

        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "edge-nginx-ok\n";
        }

        location ~ /\.(?!well-known) {
            deny all;
            access_log off;
            log_not_found off;
        }

        {% if route.name == "api" %}
        location ~* ^/(auth|account|login|register|token|refresh) {
            limit_req zone=api_auth burst=3 nodelay;
            limit_req_status 429;

            proxy_pass http://{{ route.upstream }};
            include /etc/nginx/proxy-params.conf;
        }

        location ~* ^/(media|upload|uploads|files|file) {
            client_max_body_size 50m;

            limit_req zone=api_upload burst=2 nodelay;
            limit_req_status 429;

            proxy_request_buffering off;

            proxy_pass http://{{ route.upstream }};
            include /etc/nginx/proxy-params.conf;
        }
        {% endif %}
    }

{% endfor %}
}
