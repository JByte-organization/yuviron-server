MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
MYSQL_DATABASE=<YOUR_MYSQL_DATABASE>
MYSQL_USER=<YOUR_MYSQL_USER>
MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=server=mysql;port=3306;database=<YOUR_MYSQL_DATABASE>;user=<YOUR_MYSQL_USER>;password=<YOUR_MYSQL_PASSWORD>;
ConnectionStrings__Redis=redis:6379
Swagger__Enabled=true

FILE_STORAGE_ROOT=/var/yuviron-server/storage


# ================ Edge ports ================
# Defaults are env-specific when omitted:
# dev -> 8080/8443, prod -> 80/443.
# Uncomment to override.
# HTTP_PORT=80
# HTTPS_PORT=443

# ================ TLS certificate mode ================
# Defaults are env-specific when omitted:
# dev -> shared, prod -> per-route.
# shared uses one SAN/wildcard certificate; per-route maps each route host to its own cert/key.
# NGINX_CERT_MODE=per-route


# ================ SEQ ================
SEQ_FIRSTRUN_ADMINUSERNAME=<YOUR_SEQ_ADMIN_USERNAME>
SEQ_FIRSTRUN_ADMINPASSWORDHASH=<YOUR_SEQ_ADMIN_PASSWORD_HASH>


# ================ SEQ SINK ================
Seq__ServerUrl=http://seq:5341


# ================ ASPIRE ================
ASPIRE_ASPNETCORE_URLS=http://0.0.0.0:18888
ASPIRE_OTLP_ENDPOINT_URL=http://0.0.0.0:18889

ASPIRE_FRONTEND_AUTH_MODE=BrowserToken
ASPIRE_FRONTEND_BROWSER_TOKEN=<YOUR_ASPIRE_BROWSER_TOKEN_MIN_32_CHARS>


# ================ ASPIRE OTLP SECURITY ================
ASPIRE_OTLP_API_KEY=<YOUR_ASPIRE_OTLP_API_KEY_MIN_32_CHARS>


# ================ OpenTelemetry ================
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_HEADERS=x-otlp-api-key=${ASPIRE_OTLP_API_KEY}


# ================ RabbitMQ ================
RABBITMQ_DEFAULT_USER=<YOUR_RABBITMQ_USER>
RABBITMQ_DEFAULT_PASS=<YOUR_RABBITMQ_PASSWORD>
RABBITMQ_DEFAULT_VHOST=/<YOUR_RABBITMQ_VHOST>

RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=<YOUR_RABBITMQ_USER>
RabbitMQ__VirtualHost=/<YOUR_RABBITMQ_VHOST>


# ================ Jamendo ================
# https://developer.jamendo.com/v3.0
JamendoApi__ClientId=<YOUR_JAMENDO_CLIENT_ID>


# ================ Backup ================
BACKUP_ROOT=./backups
BACKUP_TMP=./backups/tmp
BACKUP_LOG_DIR=./backups/logs
BACKUP_ARCHIVE_DIR=./backups/archives
BACKUP_RESTORE_TEST_TMP=./backups/restore-test

# environments to process
BACKUP_ENVS=dev,prod

# optional off-site local directory path; mount rsync/scp/cloud storage locally first
BACKUP_REMOTE_PATH=

# retention for unified archives
BACKUP_RETENTION_DAYS=14

# metadata
BACKUP_PROJECT_NAME=yuviron-server

# service names
MYSQL_SERVICE_NAME=mysql
BACKEND_SERVICE_NAME=backend
