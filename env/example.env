MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
MYSQL_DATABASE=<YOUR_MYSQL_DATABASE>
MYSQL_USER=<YOUR_MYSQL_USER>
MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=server=mysql;port=3306;database=<YOUR_MYSQL_DATABASE>;user=<YOUR_MYSQL_USER>;password=<YOUR_MYSQL_PASSWORD>;
Swagger__Enabled=true


# ================ Access control ================
# REQUIRED: Tailscale device IPs or subnet CIDRs allowed to reach management routes
# (Seq, Aspire, RabbitMQ management UI).
# Do NOT set this in common.env - that file is tracked by git.
# Set in env/<env>.env instead.
#
# Leave empty -> management routes are blocked for everyone (even from the host),
# because Docker bridge gateway IP (172.x.x.1) is NOT 127.0.0.1.
#
# Example (Tailscale /32 per device):
#   NGINX_PRIVATE_ACCESS_CIDRS=100.81.228.68/32,100.84.86.48/32
# Example (Tailscale subnet route):
#   NGINX_PRIVATE_ACCESS_CIDRS=100.64.0.0/10
NGINX_PRIVATE_ACCESS_CIDRS=<TAILNET_DEVICE_1>/32,<TAILNET_DEVICE_2>/32

# ================ Edge ports ================
# Defaults are env-specific when omitted:
# dev -> 8080/8443, prod -> 80/443.
# Uncomment to override.
# HTTP_PORT=80
# HTTPS_PORT=443

# ================ TLS certificate mode ================
# Defaults are env-specific when omitted:
# dev -> shared, prod -> per-route.
# shared uses one SAN/wildcard certificate; per-route maps each route host to its own cert/key.
# NGINX_CERT_MODE=per-route

# ================ Content Security Policy ================
# PROD REQUIRED: when unset, the built-in default CSP includes 'unsafe-inline' and
# 'unsafe-eval' for dev/frontend compatibility. Preflight and env validation both hard-error
# if this variable is missing or contains unsafe tokens in prod.
#
# For dev: leave unset — the dev-compatible default applies automatically.
# For prod: uncomment and set a strict policy. Adjust to match your frontend's actual needs.
#
# NGINX_CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self'; script-src 'self' blob:; connect-src 'self' http: https: ws: wss:; media-src 'self' data: blob: https:; worker-src 'self' blob:; manifest-src 'self'


# ================ SEQ ================
SEQ_FIRSTRUN_ADMINUSERNAME=<YOUR_SEQ_ADMIN_USERNAME>
SEQ_FIRSTRUN_ADMINPASSWORDHASH=<YOUR_SEQ_ADMIN_PASSWORD_HASH>


# ================ ASPIRE (env-specific tokens) ================
ASPIRE_FRONTEND_BROWSER_TOKEN=<YOUR_ASPIRE_BROWSER_TOKEN_MIN_32_CHARS>


# ================ ASPIRE OTLP SECURITY ================
ASPIRE_OTLP_API_KEY=<YOUR_ASPIRE_OTLP_API_KEY_MIN_32_CHARS>


# ================ Redis (env-specific password) ================
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>


# ================ RabbitMQ (env-specific password) ================
RABBITMQ_DEFAULT_PASS=<YOUR_RABBITMQ_PASSWORD>


# ================ Jamendo ================
# https://developer.jamendo.com/v3.0
JamendoApi__ClientId=<YOUR_JAMENDO_CLIENT_ID>


# ================ Backend secrets ================
# These replace appsettings.*.json — secrets are never baked into the Docker image.
# CORS origins (CORS_ORIGIN_0..3) are derived automatically from BASE_DOMAIN + ENVIRONMENT
# by generate-config.py and written to generated/<env>/deploy.env — do not set manually.

# JWT signing secret — min 32 chars. Rotate to invalidate all active sessions.
JWT_SECRET=<YOUR_JWT_SECRET_MIN_32_CHARS>

# Gmail sender account (create an App Password in Google Account → Security → 2-Step → App passwords)
EMAIL_USERNAME=<YOUR_GMAIL_ADDRESS>
EMAIL_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>

# Seed users created on first migration. Must meet ASP.NET Core Identity complexity rules.
SEED_ADMIN_EMAIL=<ADMIN_EMAIL>
SEED_ADMIN_PASSWORD=<ADMIN_PASSWORD>
SEED_MANAGER_EMAIL=<MANAGER_EMAIL>
SEED_MANAGER_PASSWORD=<MANAGER_PASSWORD>
SEED_USER_EMAIL=<USER_EMAIL>
SEED_USER_PASSWORD=<USER_PASSWORD>
SEED_PREMIUM_EMAIL=<PREMIUM_EMAIL>
SEED_PREMIUM_PASSWORD=<PREMIUM_PASSWORD>

# HLS stream URL signing secret — min 32 chars.
STREAM_SECRET=<YOUR_STREAM_SECRET_MIN_32_CHARS>

# Ad cooldown — minutes between ad impressions. Default 2 (dev). Set to 15 in prod.
# AD_COOLDOWN_MINUTES=15

# ---- Optional business/infrastructure overrides (all have sensible defaults) ----
# JWT token lifetime in minutes (default 60). Shorter = more secure, more re-logins.
# JWT_EXPIRY_MINUTES=60
# JWT issuer / audience claims (must match frontend SDK configuration).
# JWT_ISSUER=YuvironApi
# JWT_AUDIENCE=YuvironClient
# SMTP server — override if not using Gmail.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# Artist profile limits per subscription tier.
# FREE_USER_MAX_PROFILES=1
# PREMIUM_USER_MAX_PROFILES=5
# HLS transcoding audio bitrates (comma-separated, kbps).
# HLS_QUALITIES=128,320
# ffmpeg loudnorm filter applied during HLS encoding.
# FFMPEG_AUDIO_FILTERS=-af loudnorm=I=-14:LRA=11:TP=-1.5


# ================ Stripe ================
# Required in prod. Backend will start but fail at runtime if missing.
Stripe__SecretKey=<YOUR_STRIPE_SECRET_KEY>
Stripe__WebhookSecret=<YOUR_STRIPE_WEBHOOK_SECRET>


# ================ RabbitMQ image ================
# Dev only: uncomment to enable the management UI on port 15672.
# Prod: leave unset — defaults to rabbitmq:3 (no management plugin).
# RABBITMQ_IMAGE=rabbitmq:3-management


# ================ Backup (env-specific restore controls) ================
BACKUP_RESTORE_TEST_AFTER_CREATE=1
RESTORE_TEST_MIN_TABLES=1


# ================ Monitoring / Alerting ================
# Healthcheck email alerts (cron every 5 min, no new containers needed)
#   Setup: ./scripts/cli.py tools setup-healthcheck-cron <env>
#   Gmail app password: https://myaccount.google.com/security -> 2-Step Verification -> App passwords
ALERTS_EMAIL=<YOUR_EMAIL>
SMTP_USER=<YOUR_GMAIL>
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>

# External uptime monitoring — checks HTTPS endpoints from outside
#   Setup: ./scripts/cli.py tools setup-monitoring <env>
#   API key: https://uptimerobot.com -> My Settings -> API Settings -> Main API Key
# UPTIMEROBOT_API_KEY=<YOUR_UPTIMEROBOT_API_KEY>
