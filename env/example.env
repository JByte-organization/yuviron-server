MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
MYSQL_DATABASE=<YOUR_MYSQL_DATABASE>
MYSQL_USER=<YOUR_MYSQL_USER>
MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=server=mysql;port=3306;database=<YOUR_MYSQL_DATABASE>;user=<YOUR_MYSQL_USER>;password=<YOUR_MYSQL_PASSWORD>;
Swagger__Enabled=true


# ================ Access control ================
# REQUIRED: Tailscale device IPs or subnet CIDRs allowed to reach management routes
# (Seq, Aspire, RabbitMQ management UI).
# Do NOT set this in common.env - that file is tracked by git.
# Set in env/<env>.env instead.
#
# Leave empty → management routes are blocked for everyone (even from the host),
# because Docker bridge gateway IP (172.x.x.1) is NOT 127.0.0.1.
#
# Example (Tailscale /32 per device):
#   NGINX_PRIVATE_ACCESS_CIDRS=100.81.228.68/32,100.84.86.48/32
# Example (Tailscale subnet route):
#   NGINX_PRIVATE_ACCESS_CIDRS=100.64.0.0/10
NGINX_PRIVATE_ACCESS_CIDRS=<TAILNET_DEVICE_1>/32,<TAILNET_DEVICE_2>/32

# ================ Edge ports ================
# Defaults are env-specific when omitted:
# dev -> 8080/8443, prod -> 80/443.
# Uncomment to override.
# HTTP_PORT=80
# HTTPS_PORT=443

# ================ TLS certificate mode ================
# Defaults are env-specific when omitted:
# dev -> shared, prod -> per-route.
# shared uses one SAN/wildcard certificate; per-route maps each route host to its own cert/key.
# NGINX_CERT_MODE=per-route

# ================ Content Security Policy ================
# PROD REQUIRED: when unset, the built-in default CSP includes 'unsafe-inline' and
# 'unsafe-eval' for dev/frontend compatibility. Preflight and env validation both hard-error
# if this variable is missing or contains unsafe tokens in prod.
#
# For dev: leave unset — the dev-compatible default applies automatically.
# For prod: uncomment and set a strict policy. Adjust to match your frontend's actual needs.
#
# NGINX_CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self'; script-src 'self' blob:; connect-src 'self' http: https: ws: wss:; media-src 'self' data: blob: https:; worker-src 'self' blob:; manifest-src 'self'


# ================ SEQ ================
SEQ_FIRSTRUN_ADMINUSERNAME=<YOUR_SEQ_ADMIN_USERNAME>
SEQ_FIRSTRUN_ADMINPASSWORDHASH=<YOUR_SEQ_ADMIN_PASSWORD_HASH>


# ================ ASPIRE (env-specific tokens) ================
ASPIRE_FRONTEND_BROWSER_TOKEN=<YOUR_ASPIRE_BROWSER_TOKEN_MIN_32_CHARS>


# ================ ASPIRE OTLP SECURITY ================
ASPIRE_OTLP_API_KEY=<YOUR_ASPIRE_OTLP_API_KEY_MIN_32_CHARS>


# ================ Redis (env-specific password) ================
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>


# ================ RabbitMQ (env-specific password) ================
RABBITMQ_DEFAULT_PASS=<YOUR_RABBITMQ_PASSWORD>


# ================ Jamendo ================
# https://developer.jamendo.com/v3.0
JamendoApi__ClientId=<YOUR_JAMENDO_CLIENT_ID>


# ================ Backup (env-specific restore controls) ================
BACKUP_RESTORE_TEST_AFTER_CREATE=1
RESTORE_TEST_MIN_TABLES=1