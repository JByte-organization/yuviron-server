ASPIRE_OTLP_API_KEY=YV_DEV_ASPIRE_2026_4EwVQ7oYp1mK8zN3rX6cT9uB2hF5dL_Strong_api-key


# ================ OpenTelemetry ================
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
