# ================ RabbitMQ ================
RABBITMQ_DEFAULT_USER=yuviron_app
RABBITMQ_DEFAULT_PASS=yv_dev_strong_password_1234_rabbit_!
RABBITMQ_DEFAULT_VHOST=/yuviron

RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=yuviron_app
RabbitMQ__VirtualHost=/yuviron


# ================ Jamendo ================
JamendoApi__ClientId=65493600


# ================ Backup ================
BACKUP_ROOT=./backups
BACKUP_TMP=./backups/tmp
BACKUP_LOG_DIR=./backups/logs
BACKUP_ARCHIVE_DIR=./backups/archives
BACKUP_RESTORE_TEST_TMP=./backups/restore-test

# environments to process
BACKUP_ENVS=dev,prod

# optional off-site path
BACKUP_REMOTE_PATH=

# retention for unified archives
BACKUP_RETENTION_DAYS=14

# metadata
BACKUP_PROJECT_NAME=yuviron-server

# service names
MYSQL_SERVICE_NAME=mysql
BACKEND_SERVICE_NAME=backend
