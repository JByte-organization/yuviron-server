# SHARED_NETWORK is derived automatically from project_name in config/project.yml
# (set by generate-config.py - do not hardcode here)

MYSQL_SERVICE_NAME=mysql
BACKEND_SERVICE_NAME=backend

RESTART_POLICY=unless-stopped


# ================= Build args =================
DOTNET_VERSION=9.0
DOTNET_APP_UID=10001
DOTNET_APP_GID=10001


# ================= App defaults =================
ConnectionStrings__Redis=redis:6379,password=${REDIS_PASSWORD}
FILE_STORAGE_ROOT=/app/storage

# Права доступа к директориям хранилища (octal).
# По умолчанию 0755: только контейнер (DOTNET_APP_UID) может писать после chown.
# Chown выполняется автоматически через alpine-контейнер при stack up / preflight.
# Переопределять не рекомендуется; 0777 отключает защиту владельца.
# STORAGE_DIR_MODE=0755


# ================= Security / Nginx =================
NGINX_PUBLIC_RATE_LIMIT=20r/s
NGINX_PUBLIC_RATE_BURST=40
NGINX_WORKER_CONNECTIONS=1024

# кто может ходить в management endpoints
# Не используй весь Tailscale CGNAT 100.64.0.0/10 для management routes.
# Укажи CIDR конкретного Tailnet/subnet route или список Tailnet device /32
# в env/<env>.env, например: NGINX_PRIVATE_ACCESS_CIDRS=100.81.228.0/24,10.8.0.0/24
NGINX_ADMIN_ALLOWLIST=127.0.0.1/32,${NGINX_PRIVATE_ACCESS_CIDRS}

# basic auth для внутренних панелей
NGINX_BASIC_AUTH_USER=admin
NGINX_BASIC_AUTH_FILE=./generated/${ENVIRONMENT}/htpasswd

# логи и ops
OPS_LOG_DIR=./logs/ops

# ================= Monitoring / Alerting =================
# Safe defaults only — credentials go in env/<env>.env
# Setup: ./scripts/cli.py tools setup-monitoring <env>
#        ./scripts/cli.py tools setup-healthcheck-cron <env>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587


# ================= Migration safety =================
ALLOW_PRODUCTION_MIGRATE=false


# ================= SEQ SINK =================
Seq__ServerUrl=http://seq:5341


# ================= ASPIRE =================
ASPIRE_ASPNETCORE_URLS=http://0.0.0.0:18888
ASPIRE_OTLP_ENDPOINT_URL=http://0.0.0.0:18889
ASPIRE_FRONTEND_AUTH_MODE=BrowserToken


# ================= OpenTelemetry =================
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_HEADERS=x-otlp-api-key=${ASPIRE_OTLP_API_KEY}


# ================= RabbitMQ (connection) =================
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_VHOST=/app

RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__Username=app
RabbitMQ__VirtualHost=/app


# ================= Backup =================
BACKUP_ROOT=./backups
BACKUP_TMP=./backups/tmp
BACKUP_LOG_DIR=./backups/logs
BACKUP_ARCHIVE_DIR=./backups/archives
BACKUP_RESTORE_TEST_TMP=./backups/restore-test

# environments to process — override in env/<env>.env if you run multiple stacks
BACKUP_ENVS=prod

# optional custom storage paths
BACKUP_STORAGE_DEV=./storage/dev
BACKUP_STORAGE_PROD=./storage/prod

# Offsite backup: транспорт + адрес назначения.
# Транспорты: local (default) | rsync | scp | s3
# Автодетект по формату BACKUP_REMOTE_PATH если BACKUP_REMOTE_TRANSPORT пуст:
#   /mnt/nas/backups/          → local (смонтированный диск)
#   user@host:/srv/backups/    → rsync по SSH
#   s3://my-bucket/backups/    → AWS S3
# Доп. переменные: BACKUP_SSH_KEY_FILE, BACKUP_S3_STORAGE_CLASS
BACKUP_REMOTE_TRANSPORT=
BACKUP_REMOTE_PATH=

# retention for unified archives
BACKUP_RETENTION_DAYS=14


# ================= Resource limits =================
MYSQL_MEM_LIMIT=1g
MYSQL_MEMSWAP_LIMIT=1g
MYSQL_CPUS=1.0

REDIS_MEM_LIMIT=256m
REDIS_MEMSWAP_LIMIT=256m
REDIS_CPUS=0.25
# maxmemory — лимит памяти Redis для данных (без учёта overhead самого процесса).
# Должен быть меньше REDIS_MEM_LIMIT чтобы избежать OOM kill контейнера.
# maxmemory-policy — что делать при исчерпании: allkeys-lru удаляет
# наименее используемые ключи (подходит для кэша). Если Redis используется
# исключительно для сессий и потеря сессий недопустима — поставь volatile-lru
# (удаляет только ключи с TTL). noeviction (дефолт Redis) блокирует запись
# при полной памяти и роняет backend.
REDIS_MAXMEMORY=200m
REDIS_MAXMEMORY_POLICY=allkeys-lru

RABBITMQ_MEM_LIMIT=768m
RABBITMQ_MEMSWAP_LIMIT=768m
RABBITMQ_CPUS=0.5

SEQ_MEM_LIMIT=512m
SEQ_MEMSWAP_LIMIT=512m
SEQ_CPUS=0.5
# Выделенный UID/GID для Seq-процесса внутри контейнера.
# 10002 — следующий после 10001 (dotnet/nginx), не конфликтует ни с системными (1-999),
# ни с первым пользователем Ubuntu (1000), ни с backend-контейнерами (10001).
# Seq-том (SEQ_STORAGE_PATH) chown-ится к этому UID при stack up / preflight.
SEQ_UID=10002
SEQ_GID=10002

ASPIRE_MEM_LIMIT=512m
ASPIRE_MEMSWAP_LIMIT=512m
ASPIRE_CPUS=0.25

MIGRATOR_MEM_LIMIT=512m
MIGRATOR_MEMSWAP_LIMIT=512m
MIGRATOR_CPUS=0.5

BACKEND_MEM_LIMIT=1g
BACKEND_MEMSWAP_LIMIT=1g
BACKEND_CPUS=1.0

MEDIA_WORKER_MEM_LIMIT=768m
MEDIA_WORKER_MEMSWAP_LIMIT=768m
MEDIA_WORKER_CPUS=0.75

CLIENT_APP_MEM_LIMIT=256m
CLIENT_APP_MEMSWAP_LIMIT=256m
CLIENT_APP_CPUS=0.25

ADMIN_MEM_LIMIT=256m
ADMIN_MEMSWAP_LIMIT=256m
ADMIN_CPUS=0.25

BACKOFFICE_MEM_LIMIT=256m
BACKOFFICE_MEMSWAP_LIMIT=256m
BACKOFFICE_CPUS=0.25

NGINX_MEM_LIMIT=128m
NGINX_MEMSWAP_LIMIT=128m
NGINX_CPUS=0.25